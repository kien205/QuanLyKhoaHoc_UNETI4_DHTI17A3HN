@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="state-card state-card-error">
    <span class="state-card-icon" aria-hidden="true">!</span>
    <span class="section-kicker">CÓ SỰ CỐ</span>
    <h1>Rất tiếc, trang này chưa thể tải.</h1>
    <p>Đã xảy ra lỗi trong quá trình xử lý yêu cầu. Bạn có thể quay lại trang chủ và thử lại sau.</p>
    @if (Model.ShowRequestId)
    {
        <p class="request-reference">Mã yêu cầu <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Về trang chủ <span aria-hidden="true">→</span></a>
</div>
