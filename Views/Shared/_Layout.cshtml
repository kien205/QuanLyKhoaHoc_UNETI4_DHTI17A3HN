@using QuanLyKhoaHoc_UNETI4_DHTI17A3HN.Models
@using static QuanLyKhoaHoc_UNETI4_DHTI17A3HN.Models.HangSo
@{
    var vaiTro = Context.Session.GetString(SessionKeys.VaiTro);
    var hoTen = Context.Session.GetString(SessionKeys.HoTen);
    var laAdmin = vaiTro == VaiTroTaiKhoan.Admin;
    var laNhanVien = vaiTro == VaiTroTaiKhoan.NhanVienDaoTao;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyKhoaHoc_UNETI4_DHTI17A3HN</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyKhoaHoc_UNETI4_DHTI17A3HN.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Quản lý khóa học</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="LopHoc" asp-action="Index">Lớp học</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="LichKiemTraDauVao" asp-action="Index">Lịch kiểm tra</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="KetQuaXepLop" asp-action="Index">Kết quả xếp lớp</a>
                        </li>

                        @if (laAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="TaiKhoan" asp-action="Index">Tài khoản</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ChuongTrinhDaoTao" asp-action="Index">Chương trình đào tạo</a>
                            </li>
                        }

                        @if (laAdmin || laNhanVien)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="HoSoDangKyHoc" asp-action="Index">Hồ sơ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ThongKe" asp-action="Index">Thống kê</a>
                            </li>
                        }
                    </ul>

                    @if (hoTen != null)
                    {
                        <form asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="d-flex align-items-center">
                            <span class="me-3">Xin chào, <strong>@hoTen</strong> (@vaiTro)</span>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-area="" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["ThanhCong"] != null)
            {
                <div class="alert alert-success">@TempData["ThanhCong"]</div>
            }
            @if (TempData["Loi"] != null)
            {
                <div class="alert alert-danger">@TempData["Loi"]</div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Hệ thống quản lý khóa học và đăng ký học viên
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>