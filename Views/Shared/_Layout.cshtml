@* Họ và tên: Nguyễn Văn Giáp
   Mã sinh viên: 22103100110
   Nội dung thực hiện: Bổ sung menu học viên và làm mới khung giao diện chung. *@
@using QuanLyKhoaHoc_UNETI4_DHTI17A3HN.Models
@using static QuanLyKhoaHoc_UNETI4_DHTI17A3HN.Models.HangSo
@{
    var vaiTro = Context.Session.GetString(SessionKeys.VaiTro);
    var hoTen = Context.Session.GetString(SessionKeys.HoTen);
    var laAdmin = vaiTro == VaiTroTaiKhoan.Admin;
    var laNhanVien = vaiTro == VaiTroTaiKhoan.NhanVienDaoTao;
    var laHocVien = vaiTro == VaiTroTaiKhoan.HocVien;
    var chuCaiDau = string.IsNullOrWhiteSpace(hoTen) ? "U" : hoTen.Trim()[0].ToString().ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyKhoaHoc_UNETI4_DHTI17A3HN</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyKhoaHoc_UNETI4_DHTI17A3HN.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">U</span>
                    <span>UNETI <small>ACADEMY</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="navbarSupportedContent" class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1 app-nav-links">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        @if (laHocVien)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="HocVien" asp-action="Index">Hồ sơ cá nhân</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="DangKyHoc" asp-action="LopDangMo">Lớp đang mở</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="DangKyHoc" asp-action="HoSoCuaToi">Hồ sơ đăng ký</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="LopHoc" asp-action="Index">Lớp học</a>
                            </li>
                        }

                        @if (laAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="TaiKhoan" asp-action="Index">Tài khoản</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="ChuongTrinhDaoTao" asp-action="Index">Chương trình đào tạo</a>
                            </li>
                        }

                        @if (laAdmin || laNhanVien)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="HoSoXetDuyet" asp-action="Index">Hồ sơ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="LichKiemTraDauVao" asp-action="Index">Lịch kiểm tra</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="KetQuaXepLop" asp-action="Index">Kết quả xếp lớp</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="ThongKe" asp-action="Index">Thống kê</a>
                            </li>
                        }
                    </ul>

                    @if (hoTen != null)
                    {
                        <form asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="d-flex align-items-center gap-3 app-user-menu">
                            <span class="user-chip"><span class="user-avatar">@chuCaiDau</span><span><strong>@hoTen</strong><small>@vaiTro</small></span></span>
                            <button type="submit" class="btn btn-sm btn-outline-light">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-light app-login-link" asp-area="" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập <span aria-hidden="true">→</span></a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-content">
        <main role="main" class="pb-4">
            @if (TempData["ThanhCong"] != null)
            {
                <div class="alert alert-success app-alert">@TempData["ThanhCong"]</div>
            }
            @if (TempData["Loi"] != null)
            {
                <div class="alert alert-danger app-alert">@TempData["Loi"]</div>
            }

            <div class="app-page">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">
            <span class="brand-mark brand-mark-small" aria-hidden="true">U</span>
            <span>&copy; 2026 UNETI Academy</span>
            <span class="footer-note">Hệ thống quản lý khóa học &amp; đăng ký học viên</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>