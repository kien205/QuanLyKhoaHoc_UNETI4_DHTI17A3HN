@model QuanLyKhoaHoc_UNETI4_DHTI17A3HN.ViewModels.LapLichViewModel

@{
    ViewData["Title"] = "Lập lịch kiểm tra đầu vào";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Lập lịch kiểm tra đầu vào</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</div>

<form asp-action="Create" method="post" style="max-width: 720px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="MaHoSo" class="form-label"></label>
        <select asp-for="MaHoSo" asp-items="Model.DanhSachHoSo" class="form-select">
            <option value="">-- Chọn hồ sơ --</option>
        </select>
        <span asp-validation-for="MaHoSo" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ThoiGianBatDau" class="form-label"></label>
            <input asp-for="ThoiGianBatDau" type="datetime-local" class="form-control" />
            <span asp-validation-for="ThoiGianBatDau" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ThoiGianKetThuc" class="form-label"></label>
            <input asp-for="ThoiGianKetThuc" type="datetime-local" class="form-control" />
            <span asp-validation-for="ThoiGianKetThuc" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="HinhThucKiemTra" class="form-label"></label>
        <input asp-for="HinhThucKiemTra" class="form-control" placeholder="Trực tiếp / Trực tuyến" />
        <span asp-validation-for="HinhThucKiemTra" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DiaDiemHoacLienKet" class="form-label"></label>
        <input asp-for="DiaDiemHoacLienKet" class="form-control" />
        <span asp-validation-for="DiaDiemHoacLienKet" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GiaoVienKiemTra" class="form-label"></label>
        <input asp-for="GiaoVienKiemTra" class="form-control" />
        <span asp-validation-for="GiaoVienKiemTra" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GhiChu" class="form-label"></label>
        <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
        <span asp-validation-for="GhiChu" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lập lịch</button>
</form>