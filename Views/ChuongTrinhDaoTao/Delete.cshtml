@* Làm mới giao diện xác nhận xóa chương trình đào tạo: Nguyễn Văn Giáp, 22103100110. *@
@model QuanLyKhoaHoc_UNETI4_DHTI17A3HN.Models.ChuongTrinhDaoTao

@{
    ViewData["Title"] = "Xóa chương trình đào tạo";
}

<div class="page-heading">
    <div>
        <span class="section-kicker">DANH MỤC ĐÀO TẠO</span>
        <h1>Xóa chương trình</h1>
        <p>Vui lòng kiểm tra thông tin trước khi xác nhận.</p>
    </div>
</div>

<section class="content-panel">
    <div class="alert alert-warning app-alert">
        <strong>Lưu ý:</strong> Chỉ có thể xóa chương trình khi chưa có lớp học liên quan.
    </div>
    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Tên chương trình</span>
            <strong>@Model.TenChuongTrinhDaoTao</strong>
        </div>
        <div class="detail-item">
            <span class="detail-label">Email liên hệ</span>
            <strong>@(string.IsNullOrWhiteSpace(Model.EmailLienHe) ? "Chưa cập nhật" : Model.EmailLienHe)</strong>
        </div>
        <div class="detail-item detail-item-wide">
            <span class="detail-label">Mô tả</span>
            <p>@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Chưa có mô tả." : Model.MoTa)</p>
        </div>
    </div>
    <form asp-action="Delete" class="d-flex flex-wrap gap-2 mt-4">
        <input type="hidden" asp-for="MaChuongTrinhDaoTao" />
        <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</section>
