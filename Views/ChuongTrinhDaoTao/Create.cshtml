@model QuanLyKhoaHoc_UNETI4_DHTI17A3HN.Models.ChuongTrinhDaoTao

@{
    ViewData["Title"] = "Thêm chương trình đào tạo";
}

<h2>Thêm chương trình đào tạo</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="TenChuongTrinhDaoTao" class="form-label"></label>
                <input asp-for="TenChuongTrinhDaoTao" class="form-control" />
                <span asp-validation-for="TenChuongTrinhDaoTao" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label"></label>
                <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EmailLienHe" class="form-label"></label>
                <input asp-for="EmailLienHe" class="form-control" />
                <span asp-validation-for="EmailLienHe" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="TrangThai" class="form-check-input" />
                <label asp-for="TrangThai" class="form-check-label"></label>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}