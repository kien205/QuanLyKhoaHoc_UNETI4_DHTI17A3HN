@* Làm mới giao diện chi tiết chương trình đào tạo: Nguyễn Văn Giáp, 22103100110. *@
@model QuanLyKhoaHoc_UNETI4_DHTI17A3HN.Models.ChuongTrinhDaoTao

@{
    ViewData["Title"] = "Chi tiết chương trình đào tạo";
}

<div class="page-heading">
    <div>
        <span class="section-kicker">DANH MỤC ĐÀO TẠO</span>
        <h1>Chi tiết chương trình</h1>
        <p>Thông tin tổng quan và trạng thái hoạt động.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
</div>

<section class="content-panel">
    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Tên chương trình</span>
            <strong>@Model.TenChuongTrinhDaoTao</strong>
        </div>
        <div class="detail-item">
            <span class="detail-label">Email liên hệ</span>
            <strong>@(string.IsNullOrWhiteSpace(Model.EmailLienHe) ? "Chưa cập nhật" : Model.EmailLienHe)</strong>
        </div>
        <div class="detail-item detail-item-wide">
            <span class="detail-label">Mô tả</span>
            <p>@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Chưa có mô tả cho chương trình này." : Model.MoTa)</p>
        </div>
        <div class="detail-item">
            <span class="detail-label">Số lớp trực thuộc</span>
            <strong>@Model.LopHocs.Count</strong>
        </div>
        <div class="detail-item">
            <span class="detail-label">Trạng thái</span>
            @if (Model.TrangThai)
            {
                <span class="badge bg-success-subtle text-success-emphasis">Đang hoạt động</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary-emphasis">Đã ngừng</span>
            }
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.MaChuongTrinhDaoTao" class="btn btn-primary">Chỉnh sửa chương trình</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>
</section>
